#!/bin/bash

# --- Validação de Argumentos ---
if [[ $# -lt 1 ]]; then
    echo "❌ Uso: $0 [arquivos...] [--tune anime|action|cult] [--sub-only] [--sub-sync] [--sub-shift N] [--audio-lang LANG[,LANG...]] [--audio-index N] [--sub-lang LANG] [--title-from-file] [--title-eng]"
    echo ""
    echo "Exemplos:"
    echo "  $0 '*.mkv'"
    echo "  $0 *.mkv                                    # wildcards sem aspas"
    echo "  $0 '*.mkv' --tune anime"
    echo "  $0 '*.mkv' --tune action"
    echo "  $0 '*.mkv' --sub-only                       # apenas embute legenda, sem re-encode"
    echo "  $0 '*.mkv' --sub-only --sub-sync            # detecta offset pelo 1º timestamp e corrige"
    echo "  $0 '*.mkv' --sub-only --sub-shift -3.5      # correção manual em segundos"
    echo "  $0 '*.mkv' --audio-lang eng                 # mantém só áudio em inglês"
    echo "  $0 '*.mkv' --audio-lang por,eng             # mantém PT-BR e inglês (ordem preservada)"
    echo "  $0 '*.mkv' --audio-index 4                  # mantém só a 5ª faixa de áudio (0-based)"
    echo "  $0 '*.mkv' --sub-lang por                   # preserva legenda embarcada em português"
    echo "  $0 '*.mkv' --audio-lang por,eng --sub-lang por  # multi-áudio + legenda embarcada"
    echo "  $0 '*.mkv' --title-from-file                # sobrescreve título pelo nome do arquivo"
    echo "  $0 '*.mkv' --title-eng                      # extrai título inglês (parte após ' / ')"
    exit 1
fi

# Coleta argumentos de arquivo e opções
TUNE_NAME="normal"
B_RATE="6.5M"; MAX_R="10M"; BUF="13M"
FILES=()
SUB_ONLY=false
AUDIO_LANG=""    # ex: "por,eng" → múltiplos -map 0:a:m:language:X
AUDIO_IDX=""     # ex: "4"      → -map 0:a:4  (0-based, único)
SUB_LANG=""      # ex: "por"    → preserva legenda embarcada do container por tag
TITLE_FROM_FILE=false
TITLE_ENG=false
SUB_SHIFT=""     # ex: "-3.5" ou "+2" → desloca legenda em segundos
SUB_SYNC=false   # detecta e corrige offset automaticamente via ffsubsync
NEXT_ARG_FOR=""

# Parse dos argumentos
for arg in "$@"; do
    # Flags que consomem o próximo token
    case "$arg" in
        --tune)            NEXT_ARG_FOR="tune";        continue ;;
        --audio-lang)      NEXT_ARG_FOR="audio-lang";  continue ;;
        --audio-index)     NEXT_ARG_FOR="audio-index"; continue ;;
        --sub-lang)        NEXT_ARG_FOR="sub-lang";    continue ;;
        --sub-shift)       NEXT_ARG_FOR="sub-shift";   continue ;;
        --sub-only)        SUB_ONLY=true;               continue ;;
        --sub-sync)        SUB_SYNC=true;               continue ;;
        --title-from-file) TITLE_FROM_FILE=true;        continue ;;
        --title-eng)        TITLE_ENG=true;               continue ;;
    esac

    # Processa o valor do token anterior
    if [[ -n "$NEXT_ARG_FOR" ]]; then
        case "$NEXT_ARG_FOR" in
            tune)
                case "$arg" in
                    anime)  B_RATE="5M";  MAX_R="8M";  BUF="10M"; TUNE_NAME="anime"  ;;
                    action) B_RATE="10M"; MAX_R="18M"; BUF="20M"; TUNE_NAME="action" ;;
                    cult)   B_RATE="12M"; MAX_R="20M"; BUF="25M"; TUNE_NAME="cult"   ;;
                esac
                ;;
            audio-lang)  AUDIO_LANG="$arg" ;;
            audio-index) AUDIO_IDX="$arg"  ;;
            sub-lang)    SUB_LANG="$arg"   ;;
            sub-shift)   SUB_SHIFT="$arg"  ;;
        esac
        NEXT_ARG_FOR=""
        continue
    fi

    # Arquivos / wildcards
    if [[ "$arg" == *"*"* ]] || [[ "$arg" == *"?"* ]]; then
        for file in $arg; do
            [[ -f "$file" ]] && FILES+=("$file")
        done
    else
        [[ -f "$arg" ]] && FILES+=("$arg")
    fi
done

# Valida se encontrou arquivos
if [[ ${#FILES[@]} -eq 0 ]]; then
    echo "❌ Nenhum arquivo encontrado"
    exit 1
fi

echo "✅ Encontrados ${#FILES[@]} arquivo(s) para processar"
if [[ "$SUB_ONLY" == true ]]; then
    echo "📋 Modo: sub-only (remux, sem re-encode)"
else
    echo "📋 Preset: $TUNE_NAME @ $B_RATE"
fi
if [[ -n "$AUDIO_LANG" ]]; then
    echo "🔊 Áudio: lang=${AUDIO_LANG// /} (ordem preservada)"
elif [[ -n "$AUDIO_IDX" ]]; then
    echo "🔊 Áudio: somente índice $AUDIO_IDX (0-based)"
fi
if [[ -n "$SUB_LANG" ]]; then
    echo "💬 Legenda embarcada: preservando lang=${SUB_LANG}"
fi
if [[ "$TITLE_FROM_FILE" == true ]]; then
    echo "🏷️  Título: será reescrito pelo nome do arquivo"
elif [[ "$TITLE_ENG" == true ]]; then
    echo "🏷️  Título: será extraído da tag existente (parte após ' / ')"
fi
if [[ -n "$SUB_SHIFT" ]]; then
    echo "⏩ Sub-shift: ${SUB_SHIFT}s (legendas serão deslocadas antes de embutir)"
fi
if [[ "$SUB_SYNC" == true ]]; then
    echo "🔄 Sub-sync: offset automático via áudio"
fi
echo ""

# --- Detecta o Sistema Operacional ---
OS="$(uname -s)"
case "${OS}" in
    Linux)
        echo "🐧 Sistema: Linux (VAAPI)"
        ENC_V="hevc_vaapi"
        VF_OPTS="format=p010,hwupload"
        VAAPI_DEV="-vaapi_device /dev/dri/renderD128"
        RC_OPTS="-rc_mode VBR"
        ;;
    Darwin)
        echo "🍎 Sistema: macOS (VideoToolbox)"
        ENC_V="hevc_videotoolbox"
        VF_OPTS="format=p010"
        VAAPI_DEV=""
        RC_OPTS=""
        ;;
    *)
        echo "❌ Sistema não suportado"
        exit 1
        ;;
esac

# --- Função: desloca timestamps de um .srt em N milissegundos ---
# Uso: shift_srt <origem.srt> <destino.srt> <segundos>
# segundos pode ser negativo ou decimal (ex: -3.5, +2, 1.25)
shift_srt() {
    local src="$1" dst="$2" shift_sec="$3"
    # Converte segundos → milissegundos inteiros (bc lida com decimais e negativos)
    local shift_ms
    shift_ms=$(printf '%.0f' "$(echo "$shift_sec * 1000" | bc -l)")
    LC_ALL=C awk -v shift="$shift_ms" '
        function ts2ms(t,   a) {
            gsub(",", ":", t)
            split(t, a, ":")
            return (a[1]*3600 + a[2]*60 + a[3]) * 1000 + a[4]
        }
        function ms2ts(ms,  h, m, s, r) {
            if (ms < 0) ms = 0
            h = int(ms / 3600000); ms -= h * 3600000
            m = int(ms / 60000);   ms -= m * 60000
            s = int(ms / 1000);    ms -= s * 1000
            return sprintf("%02d:%02d:%02d,%03d", h, m, s, ms)
        }
        /[0-9][0-9]:[0-9][0-9]:[0-9][0-9],[0-9][0-9][0-9] --> / {
            n = split($0, p, " --> ")
            printf "%s --> %s\n", ms2ts(ts2ms(p[1]) + shift), ms2ts(ts2ms(p[2]) + shift)
            next
        }
        { print }
    ' "$src" > "$dst"
}

# --- Função: detecta automaticamente se a legenda tem offset de rip ---
# Compara o 1º timestamp do .srt com o start_time do container (ffprobe).
# Se coincidirem (dentro de 1.5s), é offset de rip → aplica shift negativo.
# Se não coincidirem, o .srt já está sincronizado com este vídeo → copia sem alterar.
auto_sync_srt() {
    local video="$1" src="$2" dst="$3"
    local THRESHOLD_MS=1500   # tolerância de 1.5s para considerar "mesmo offset"

    # --- 1. Primeiro timestamp do .srt ---
    local first_line
    first_line=$(LC_ALL=C grep -m1 '[0-9][0-9]:[0-9][0-9]:[0-9][0-9],[0-9][0-9][0-9]' "$src")
    if [[ -z "$first_line" ]]; then
        echo "⚠️  Sub-sync: nenhum timestamp encontrado no .srt — legenda original mantida"
        cp "$src" "$dst"; return 1
    fi

    local start_ts
    start_ts=$(printf '%s' "$first_line" | LC_ALL=C sed -E 's/([0-9]{2}:[0-9]{2}:[0-9]{2},[0-9]{3}).*/\1/')
    local h m s ms
    IFS=':,' read -r h m s ms <<< "$start_ts"
    local srt_ms=$(( 10#$h * 3600000 + 10#$m * 60000 + 10#$s * 1000 + 10#$ms ))

    if [[ $srt_ms -eq 0 ]]; then
        echo "🔄 Sub-sync: legenda já começa em 00:00:00 — nenhum ajuste necessário"
        cp "$src" "$dst"; return 0
    fi

    # --- 2. start_time do container via ffprobe ---
    local video_start_raw
    video_start_raw=$(ffprobe -v error -show_entries format=start_time \
        -of default=noprint_wrappers=1:nokey=1 "$video" 2>/dev/null)

    local video_start_ms=0
    if [[ -n "$video_start_raw" && "$video_start_raw" != "N/A" ]]; then
        video_start_ms=$(printf '%.0f' "$(echo "$video_start_raw * 1000" | bc -l)" 2>/dev/null || echo 0)
        [[ $video_start_ms -lt 0 ]] && video_start_ms=0
    fi

    # --- 3. Decisão: offset de rip ou legenda já sincronizada? ---
    local delta=$(( srt_ms - video_start_ms ))
    [[ $delta -lt 0 ]] && delta=$(( -delta ))

    if [[ $delta -le $THRESHOLD_MS ]]; then
        # 1º timestamp ≈ start_time do vídeo → é artefato de rip, não diálogo real
        local offset_sec
        offset_sec=$(echo "scale=3; $srt_ms / 1000" | bc)
        echo "🔄 Sub-sync: offset de rip detectado (${start_ts} ≈ start_time do vídeo) → deslocando -${offset_sec}s"
        shift_srt "$src" "$dst" "-${offset_sec}"
    else
        # 1º timestamp é diálogo real, legenda já está sincronizada com este vídeo
        local srt_sec
        srt_sec=$(echo "scale=3; $srt_ms / 1000" | bc)
        local vid_sec
        vid_sec=$(echo "scale=3; $video_start_ms / 1000" | bc)
        echo "🔄 Sub-sync: 1º diálogo em ${srt_sec}s, start_time do vídeo ${vid_sec}s — legenda já sincronizada"
        cp "$src" "$dst"
    fi
}

# --- Processamento em Fila ---
TOTAL_FILES=${#FILES[@]}
CURRENT_FILE=1
FAILED_FILES=()
COMPLETED_FILES=()

for input in "${FILES[@]}"; do
    # Validação do arquivo
    if [ ! -f "$input" ]; then
        echo "⚠️  [$CURRENT_FILE/$TOTAL_FILES] Ignorado (não é arquivo): $input"
        ((CURRENT_FILE++))
        continue
    fi

    echo ""
    echo "═══════════════════════════════════════════════════════════"
    echo "📹 [$CURRENT_FILE/$TOTAL_FILES] Processando: $input"
    echo "═══════════════════════════════════════════════════════════"

    legenda="${input%.*}.srt"

    # Cria diretório output se não existir
    mkdir -p output

    # Remove pontos do nome do arquivo (mantendo a extensão)
    # Ex: filme.2024.1080p.mkv -> filme 2024 1080p.mkv
    base_name="${input%.*}"  # Remove extensão
    ext="${input##*.}"       # Pega extensão
    clean_name="${base_name//./ }"  # Substitui pontos por espaços
    output="output/${clean_name}.mkv"

    # Metadado de título (opcional)
    title_arg=()
    if [[ "$TITLE_ENG" == true ]]; then
        CURRENT_TITLE=$(ffprobe -v error -show_entries format_tags=title \
            -of default=noprint_wrappers=1:nokey=1 "$input" 2>/dev/null)
        if [[ "$CURRENT_TITLE" == *" / "* ]]; then
            EN_TITLE="${CURRENT_TITLE#*/ }"
            title_arg=("-metadata" "title=${EN_TITLE}")
            echo "🏷️  Título: '${EN_TITLE}'"
        else
            # Fallback: usa o nome do arquivo se não há padrão "X / Y"
            title_arg=("-metadata" "title=${clean_name}")
            echo "🏷️  Título (fallback filename): '${clean_name}'"
        fi
    elif [[ "$TITLE_FROM_FILE" == true ]]; then
        title_arg=("-metadata" "title=${clean_name}")
        echo "🏷️  Título: '${clean_name}'"
    fi

    # Verifica se o output já existe
    if [ -f "$output" ]; then
        echo "⚠️  Arquivo de saída já existe: $output"
        read -p "Deseja sobrescrever? (s/n): " -n 1 -r
        echo
        if [[ ! $REPLY =~ ^[Ss]$ ]]; then
            echo "⏭️  Pulando arquivo..."
            ((CURRENT_FILE++))
            continue
        fi
    fi

    # ─────────────────────────────────────────────────────────
    # MODO SUB-ONLY: remux sem re-encode, apenas embute legenda
    # ─────────────────────────────────────────────────────────
    if [[ "$SUB_ONLY" == true ]]; then
        if [ ! -f "$legenda" ]; then
            echo "⚠️  Legenda não encontrada: $legenda — pulando"
            FAILED_FILES+=("$input")
            ((CURRENT_FILE++))
            continue
        fi

        ENCODING=$(file -b --mime-encoding "$legenda")
        if [[ "$ENCODING" == "unknown-8bit" || "$ENCODING" == "binary" ]]; then
            ENCODING="iso-8859-1"
        fi

        echo "🎯 Legenda: $legenda (encoding: $ENCODING)"

        # Pipeline de transformação: sync automático → shift manual (ambos opcionais, encadeáveis)
        legenda_final="$legenda"
        SUB_TMPS=()

        if [[ "$SUB_SYNC" == true ]]; then
            _sync_tmp=$(mktemp /tmp/synced_XXXXXX.srt)
            SUB_TMPS+=("$_sync_tmp")
            auto_sync_srt "$input" "$legenda_final" "$_sync_tmp"
            legenda_final="$_sync_tmp"
        fi

        if [[ -n "$SUB_SHIFT" ]]; then
            _shift_tmp=$(mktemp /tmp/shifted_XXXXXX.srt)
            SUB_TMPS+=("$_shift_tmp")
            shift_srt "$legenda_final" "$_shift_tmp" "$SUB_SHIFT"
            legenda_final="$_shift_tmp"
            echo "⏩ Legenda deslocada ${SUB_SHIFT}s adicional"
        fi

        echo "🚀 Embutindo legenda (sem re-encode)..."
        echo "--------------------------------------------------"

        # Monta mapeamento de áudio (suporta multi-idioma via vírgula)
        sub_audio_map=()
        if [[ -n "$AUDIO_LANG" ]]; then
            IFS=',' read -ra _langs <<< "$AUDIO_LANG"
            for _lang in "${_langs[@]}"; do
                sub_audio_map+=("-map" "0:a:m:language:${_lang}")
            done
        elif [[ -n "$AUDIO_IDX" ]]; then
            sub_audio_map=("-map" "0:a:$AUDIO_IDX")
        else
            sub_audio_map=("-map" "0:a")
        fi

        # Legenda embarcada do container (--sub-lang) vai antes do .srt externo
        sub_embedded_map=()
        if [[ -n "$SUB_LANG" ]]; then
            sub_embedded_map=("-map" "0:s:m:language:${SUB_LANG}")
            echo "💬 Legenda embarcada lang=${SUB_LANG} preservada"
        fi

        ffmpeg -loglevel error -stats \
            -i "$input" \
            -sub_charenc "$ENCODING" -i "$legenda_final" \
            -map 0:v "${sub_audio_map[@]}" "${sub_embedded_map[@]}" -map 1:s:0 \
            -c copy -c:s copy \
            "${title_arg[@]}" \
            -y "$output" 2>&1

        FFMPEG_EXIT=$?
        for tmp in "${SUB_TMPS[@]}"; do rm -f "$tmp"; done

        if [ $FFMPEG_EXIT -eq 0 ]; then
            echo "--------------------------------------------------"
            echo "✅ [$CURRENT_FILE/$TOTAL_FILES] Legenda embutida com sucesso!"
            COMPLETED_FILES+=("$input")
        else
            echo "--------------------------------------------------"
            echo "❌ [$CURRENT_FILE/$TOTAL_FILES] Erro ao embutir legenda!"
            FAILED_FILES+=("$input")
        fi

        ((CURRENT_FILE++))
        continue
    fi

    # ─────────────────────────────────────────────────────────
    # MODO NORMAL: re-encode HEVC
    # ─────────────────────────────────────────────────────────

    # --- Extração de Metadados HDR e Duração ---
    echo "🔍 Analisando mídia..."
    DURATION=$(ffprobe -v error -show_entries format=duration -of default=noprint_wrappers=1:nokey=1 "$input" 2>/dev/null)
    TOTAL_SECONDS=${DURATION%.*}

    # Tratamento caso ffprobe falhe
    if [[ -z "$TOTAL_SECONDS" || "$TOTAL_SECONDS" == "N/A" ]]; then
        echo "❌ Erro ao analisar o arquivo: $input"
        FAILED_FILES+=("$input")
        ((CURRENT_FILE++))
        continue
    fi

    # Obtém FPS do vídeo fonte para calcular total de frames e ETA dinâmico
    VIDEO_FPS_RAW=$(ffprobe -v error -select_streams v:0 \
        -show_entries stream=r_frame_rate \
        -of default=noprint_wrappers=1:nokey=1 "$input" 2>/dev/null)
    if [[ "$VIDEO_FPS_RAW" == *"/"* ]]; then
        _fps_n=${VIDEO_FPS_RAW%/*}; _fps_d=${VIDEO_FPS_RAW#*/}
        VIDEO_FPS_INT=$(( _fps_d > 0 ? _fps_n / _fps_d : 24 ))
    else
        VIDEO_FPS_INT=${VIDEO_FPS_RAW%.*}
    fi
    [[ -z "$VIDEO_FPS_INT" || "$VIDEO_FPS_INT" -le 0 ]] && VIDEO_FPS_INT=24
    TOTAL_FRAMES=$(( VIDEO_FPS_INT * TOTAL_SECONDS ))

    # Pega dados de HDR
    COLOR_TRC=$(ffprobe -v error -select_streams v:0 -show_entries stream=color_transfer -of default=noprint_wrappers=1:nokey=1 "$input" 2>/dev/null | tr -d '[:space:]')

    HDR_OPTS=""
    if [ "$COLOR_TRC" == "smpte2084" ]; then
        echo "✨ HDR10 Detectado."
        HDR_OPTS="-color_primaries bt2020 -color_trc smpte2084 -colorspace bt2020nc"
        
        HDR_DATA=$(ffprobe -v error -select_streams v:0 -show_frames -read_intervals "%+#1" -show_entries frame=side_data_list "$input" 2>/dev/null)
        MAX_CLL=$(echo "$HDR_DATA" | grep "max_content_light_level" | sed 's/.*=//' | tr -d '[:space:]')
        MAX_FALL=$(echo "$HDR_DATA" | grep "max_average_light_level" | sed 's/.*=//' | tr -d '[:space:]')

        if [ ! -z "$MAX_CLL" ] && [ "$MAX_CLL" != "0" ]; then
            HDR_OPTS="$HDR_OPTS -metadata:s:v:0 max-cll=$MAX_CLL -metadata:s:v:0 max-fall=$MAX_FALL"
        fi
    fi

    # --- Configuração de Legenda e Mapas ---
    extra_args=()

    # Seleciona faixa(s) de áudio
    # AUDIO_LANG pode ser "por,eng" → gera um -map por idioma, na ordem informada
    if [[ -n "$AUDIO_LANG" ]]; then
        map_args=("-map" "0:v:0")
        IFS=',' read -ra _langs <<< "$AUDIO_LANG"
        for _lang in "${_langs[@]}"; do
            map_args+=("-map" "0:a:m:language:${_lang}")
        done
    elif [[ -n "$AUDIO_IDX" ]]; then
        map_args=("-map" "0:v:0" "-map" "0:a:$AUDIO_IDX")
    else
        map_args=("-map" "0:v:0" "-map" "0:a")
    fi

    # Legenda embarcada do container (--sub-lang): mapeada antes do .srt externo
    if [[ -n "$SUB_LANG" ]]; then
        map_args+=("-map" "0:s:m:language:${SUB_LANG}")
    fi

    if [ -f "$legenda" ]; then
        ENCODING=$(file -b --mime-encoding "$legenda")
        if [[ "$ENCODING" == "unknown-8bit" || "$ENCODING" == "binary" ]]; then
            ENCODING="iso-8859-1"
        fi
        echo "🎯 Legenda encontrada: $legenda (encoding: $ENCODING)"

        # Pipeline de transformação: sync automático → shift manual (ambos opcionais, encadeáveis)
        legenda_enc="$legenda"
        SUB_TMPS_ENC=()

        if [[ "$SUB_SYNC" == true ]]; then
            _sync_tmp=$(mktemp /tmp/synced_XXXXXX.srt)
            SUB_TMPS_ENC+=("$_sync_tmp")
            auto_sync_srt "$input" "$legenda_enc" "$_sync_tmp"
            legenda_enc="$_sync_tmp"
        fi

        if [[ -n "$SUB_SHIFT" ]]; then
            _shift_tmp=$(mktemp /tmp/shifted_XXXXXX.srt)
            SUB_TMPS_ENC+=("$_shift_tmp")
            shift_srt "$legenda_enc" "$_shift_tmp" "$SUB_SHIFT"
            legenda_enc="$_shift_tmp"
            echo "⏩ Legenda deslocada ${SUB_SHIFT}s adicional"
        fi

        extra_args+=("-sub_charenc" "$ENCODING" "-i" "$legenda_enc")
        map_args+=("-map" "1:s:0")
    fi

    # --- Execução com Porcentagem e Status ---
    echo "🚀 Iniciando encode: $TUNE_NAME @ $B_RATE"
    # Estimativa inicial conservadora: assume 50fps de encode (ajustado ao hardware observado)
    _est_secs=$(( TOTAL_FRAMES / 50 ))
    _est_min=$(( _est_secs / 60 ))
    echo "⏱️  Duração: $((TOTAL_SECONDS / 60)) min | Espera est.: ~${_est_min} min"
    echo "--------------------------------------------------"

    # Executa ffmpeg com output redirecionado para arquivo temporário
    FFMPEG_OUTPUT=$(mktemp)
    
    ffmpeg -loglevel error -stats \
        $VAAPI_DEV \
        -i "$input" "${extra_args[@]}" \
        "${map_args[@]}" \
        -vf "$VF_OPTS" \
        -c:v "$ENC_V" \
        -profile:v main10 \
        -b:v "$B_RATE" \
        -maxrate:v "$MAX_R" \
        -bufsize:v "$BUF" \
        $RC_OPTS \
        $HDR_OPTS \
        -c:a copy \
        -c:s copy \
        "${title_arg[@]}" \
        -y "$output" > "$FFMPEG_OUTPUT" 2>&1 &
    
    FFMPEG_PID=$!
    ENCODE_START_TIME=$(date +%s)
    
    # Monitora o progresso lendo arquivo temporário
    while kill -0 $FFMPEG_PID 2>/dev/null; do
        if [ -f "$FFMPEG_OUTPUT" ]; then
            # Procura pela última linha que contém "time=" em todo o arquivo
            LAST_LINE=$(grep "time=" "$FFMPEG_OUTPUT" 2>/dev/null | tail -1)
            
            if [[ -n "$LAST_LINE" ]]; then
                # Extrai tempo no formato HH:MM:SS
                TIME_STR=$(echo "$LAST_LINE" | sed -E 's/.*time=([0-9]{2}:[0-9]{2}:[0-9]{2}).*/\1/')
                
                if [[ "$TIME_STR" =~ ^[0-9]{2}:[0-9]{2}:[0-9]{2}$ ]]; then
                    IFS=: read -r h m s <<< "$TIME_STR"
                    CURRENT_SECONDS=$(( 10#$h * 3600 + 10#$m * 60 + 10#$s ))
                    
                    if [[ -n "$TOTAL_SECONDS" && "$TOTAL_SECONDS" -gt 0 ]]; then
                        PERCENT=$(echo "scale=1; ($CURRENT_SECONDS * 100) / $TOTAL_SECONDS" | bc)
                        
                        # Calcula tempo decorrido
                        CURRENT_TIME=$(date +%s)
                        ELAPSED=$((CURRENT_TIME - ENCODE_START_TIME))
                        ELAPSED_MIN=$((ELAPSED / 60))
                        ELAPSED_SEC=$((ELAPSED % 60))
                        
                        # Extrai frame e fps compatível com macOS e Linux
                        FRAME=$(echo "$LAST_LINE" | sed -E 's/.*frame= *([0-9]+).*/\1/')
                        FPS=$(echo "$LAST_LINE" | sed -E 's/.*fps= *([0-9]+).*/\1/')

                        # ETA dinâmico baseado no fps real do encode
                        ETA_STR="--:--"
                        if [[ -n "$FPS" && "$FPS" -gt 0 && -n "$TOTAL_FRAMES" && "$TOTAL_FRAMES" -gt 0 ]]; then
                            REMAINING_FRAMES=$(( TOTAL_FRAMES - FRAME ))
                            if [[ "$REMAINING_FRAMES" -gt 0 ]]; then
                                ETA_SECS=$(( REMAINING_FRAMES / FPS ))
                                ETA_STR=$(printf "%02d:%02d" $(( ETA_SECS / 60 )) $(( ETA_SECS % 60 )))
                            fi
                        fi

                        printf "\r\033[K⏳ %02d:%02d | frame=%-6s fps=%-3s [%6.1f%%] ETA %s" \
                            "$ELAPSED_MIN" "$ELAPSED_SEC" "$FRAME" "$FPS" "$PERCENT" "$ETA_STR"
                    fi
                fi
            fi
        fi
        sleep 0.5
    done
    
    # Aguarda o fim do processo
    wait $FFMPEG_PID
    FFMPEG_EXIT=$?
    
    # Limpeza
    rm -f "$FFMPEG_OUTPUT"
    for tmp in "${SUB_TMPS_ENC[@]:-}"; do [[ -f "$tmp" ]] && rm -f "$tmp"; done

    # Verifica se o ffmpeg completou com sucesso
    if [ $FFMPEG_EXIT -eq 0 ]; then
        echo -e "\n--------------------------------------------------"
        echo "✅ [$CURRENT_FILE/$TOTAL_FILES] Concluído com sucesso!"
        COMPLETED_FILES+=("$input")
    else
        echo -e "\n--------------------------------------------------"
        echo "❌ [$CURRENT_FILE/$TOTAL_FILES] Erro durante o encode!"
        echo "   Log ffmpeg:"
        grep -v '^$' "$FFMPEG_OUTPUT" | sed 's/^/   /' || true
        FAILED_FILES+=("$input")
    fi

    ((CURRENT_FILE++))
done

# --- Resumo Final ---
echo ""
echo "═══════════════════════════════════════════════════════════"
echo "📊 RESUMO DA FILA"
echo "═══════════════════════════════════════════════════════════"
echo "✅ Arquivos concluídos: ${#COMPLETED_FILES[@]}/$TOTAL_FILES"

if [ ${#COMPLETED_FILES[@]} -gt 0 ]; then
    echo ""
    echo "Arquivos processados com sucesso:"
    for file in "${COMPLETED_FILES[@]}"; do
        echo "  ✓ $file"
    done
fi

if [ ${#FAILED_FILES[@]} -gt 0 ]; then
    echo ""
    echo "❌ Arquivos com erro (${#FAILED_FILES[@]}):"
    for file in "${FAILED_FILES[@]}"; do
        echo "  ✗ $file"
    done
fi

echo ""
echo "═══════════════════════════════════════════════════════════"

# Retorna código de erro se houver falhas
if [ ${#FAILED_FILES[@]} -gt 0 ]; then
    exit 1
else
    exit 0
fi
