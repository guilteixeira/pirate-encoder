#!/bin/bash

input="$1"
if [ ! -f "$input" ]; then
    echo "❌ Erro: Arquivo '$input' não encontrado."
    exit 1
fi

shift

# Detecta o Sistema Operacional
OS="$(uname -s)"
case "${OS}" in
    Linux)
        echo "🐧 Sistema: Linux (VAAPI)"
        ENC_V="hevc_vaapi"
        VF_OPTS="format=p010,hwupload"
        VAAPI_DEV="-vaapi_device /dev/dri/renderD128"
        RC_OPTS="-rc_mode VBR"
        ;;
    Darwin)
        echo "🍎 Sistema: macOS (VideoToolbox)"
        ENC_V="hevc_videotoolbox"
        VF_OPTS="format=p010"
        VAAPI_DEV=""
        RC_OPTS=""
        ;;
    *)
        echo "❌ Sistema não suportado"
        exit 1
        ;;
esac

# Valores padrão
B_RATE="6.5M"; MAX_R="10M"; BUF="13M"; TUNE_NAME="normal"

# Processa os parâmetros --tune
while [[ "$#" -gt 0 ]]; do
    case $1 in
        --tune)
            case $2 in
                anime)  B_RATE="5M"; MAX_R="8M"; BUF="10M"; TUNE_NAME="anime" ;;
                action) B_RATE="10M"; MAX_R="18M"; BUF="20M"; TUNE_NAME="action" ;;
                cult)   B_RATE="12M"; MAX_R="20M"; BUF="25M"; TUNE_NAME="cult" ;;
            esac
            shift 2 ;;
        *) shift ;;
    esac
done

# --- Extração de Metadados HDR ---
echo "🔍 Analisando HDR..."
COLOR_TRC=$(ffprobe -v error -select_streams v:0 -show_entries stream=color_transfer -of default=noprint_wrappers=1:nokey=1 "$input" | tr -d '[:space:]')

HDR_OPTS=""
if [ "$COLOR_TRC" == "smpte2084" ]; then
    echo "✨ HDR10 Detectado."
    HDR_OPTS="-color_primaries bt2020 -color_trc smpte2084 -colorspace bt2020nc"
    
    HDR_DATA=$(ffprobe -v error -select_streams v:0 -show_frames -read_intervals "%+#1" -show_entries frame=side_data_list "$input")
    MAX_CLL=$(echo "$HDR_DATA" | grep "max_content_light_level" | sed 's/.*=//' | tr -d '[:space:]')
    MAX_FALL=$(echo "$HDR_DATA" | grep "max_average_light_level" | sed 's/.*=//' | tr -d '[:space:]')

    if [ ! -z "$MAX_CLL" ] && [ "$MAX_CLL" != "0" ]; then
        HDR_OPTS="$HDR_OPTS -metadata:s:v:0 max-cll=$MAX_CLL -metadata:s:v:0 max-fall=$MAX_FALL"
    fi
fi

legenda="${input%.*}.srt"
output="${input%.*} - REENCODED.mkv"

# --- Configuração de Legenda e Mapas ---
extra_args=()
map_args=("-map" "0:v:0" "-map" "0:a")

if [ -f "$legenda" ]; then
    ENCODING=$(file -b --mime-encoding "$legenda")
    if [[ "$ENCODING" == "unknown-8bit" || "$ENCODING" == "binary" ]]; then
        ENCODING="iso-8859-1"
    fi
    extra_args+=("-sub_charenc" "$ENCODING" "-i" "$legenda")
    map_args+=("-map" "1:s:0")
fi

echo "🚀 Iniciando encode: $TUNE_NAME @ $B_RATE"

# --- Execução do FFmpeg ---
ffmpeg $VAAPI_DEV \
    -analyzeduration 100M -probesize 100M \
    -i "$input" "${extra_args[@]}" \
    "${map_args[@]}" \
    -vf "$VF_OPTS" \
    -c:v "$ENC_V" \
    -profile:v main10 \
    -b:v "$B_RATE" \
    -maxrate:v "$MAX_R" \
    -bufsize:v "$BUF" \
    $RC_OPTS \
    $HDR_OPTS \
    -c:a copy \
    -c:s srt \
    -y "$output"
